        "uid": "loki"
      },
      "description": "Markers sized by request count. IP geolocation by DB-IP (https://db-ip.com), CC BY 4.0. LAN clients have no location and are not shown.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "unit": "short"
        },
        "overrides": []
