                  "max": 30,
                  "min": 4
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                }
              }
            },
            "location": {
              "latitude": "geo_lat",
              "longitude": "geo_lon",
              "mode": "coords"
            },
            "name": "Requests",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": {
          "mode": "details"
        },
        "view": {
          "allLayers": true,
          "id": "zero",
          "lat": 25,
          "lon": 10,
          "zoom": 1.6
        }
      },
      "targets": [
        {
          "expr": "sum by (geo_country, geo_city, geo_lat, geo_lon) (count_over_time({namespace=\"kube-system\", container=\"cilium-envoy\"} |= \"client_ip\" | json | gateway=~\"gateway/(${gateway:regex})\" | user_agent !~ \"(Blackbox-Exporter|kube-probe|mcp-grafana).*\" | geo_lat != \"\" [$__range]))",
          "format": "table",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Where requests come from",
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "number",
                "targetField": "geo_lat"
              },
              {
                "destinationType": "number",
                "targetField": "geo_lon"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Requests",
              "Value #A": "Requests",
              "geo_city": "City",
              "geo_country": "Country"
            }
          }
        }
