                "config": {
                  "id": "isNull",
                  "options": {}
                },
                "fieldName": "Value #B"
              }
            ],
            "match": "any",
            "type": "exclude"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "namespace": 1,
              "node": 0,
              "pod": 2
            },
            "renameByName": {
              "Value #A": "CPU",
              "Value #B": "Memory",
              "Value #C": "Restarts",
              "namespace": "Namespace",
              "node": "Node",
              "pod": "Pod"
            }
          }
        }
      ],
      "type": "table"
    },
