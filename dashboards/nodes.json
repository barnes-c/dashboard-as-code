          "expr": "1000 * sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) * on (namespace, pod) group_left(node) max by (namespace, pod, node) (kube_pod_info{node=~\"${node:regex}\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\"}) * on (namespace, pod) group_left(node) max by (namespace, pod, node) (kube_pod_info{node=~\"${node:regex}\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "max by (namespace, pod) (sum by (namespace, pod, instance) (kube_pod_container_status_restarts_total)) * on (namespace, pod) group_left(node) max by (namespace, pod, node) (kube_pod_info{node=~\"${node:regex}\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "title": "Pods on $node",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
